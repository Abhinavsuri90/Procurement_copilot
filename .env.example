# Any OpenAI-compatible endpoint with function calling (OpenAI, Gemini, Groq, OpenRouter, local Ollama)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=60
LLM_MODE=live            # live | record | replay
VENDOR_SERVICE_URL=http://localhost:8001
VENDOR_SERVICE_FAULT=    # empty | down | slow | flaky (testing only)
AS_OF_DATE=              # YYYY-MM-DD used for expiry checks; empty = the reference date in data/procurement_policy.md
APP_PORT=8000
DB_PATH=var/app.db
PRICE_PER_1M_INPUT_TOKENS=
PRICE_PER_1M_OUTPUT_TOKENS=
